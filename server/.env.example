PORT=3001
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/orion

# Admin emails that bypass @thapar.edu restriction (comma-separated)
ADMIN_EMAILS=admin@thapar.edu

# JWT Secret (change this to a long random string)
JWT_SECRET=your-super-secret-jwt-key-change-this

# Email (Gmail for password reset)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# ============================================
# CLOUDFLARE R2 STORAGE CONFIGURATION
# ============================================
# If these are not set, the app will use base64 fallback (for development)

# R2 Chat Bucket (for images, videos, audio - temporary storage)
# - Max file size: 10MB
# - URL type: Presigned (expires in 30 minutes)
# - Recommended: Set lifecycle rule to delete after 7 days
R2_CHAT_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_CHAT_ACCESS_KEY=your-access-key
R2_CHAT_SECRET_KEY=your-secret-key
R2_CHAT_BUCKET=orion-chat

# R2 Social Bucket (for profile pics and posts - permanent storage)
# - Max file size: 300KB (auto-compressed)
# - URL type: Public (permanent access)
# - Enable public access (R2.dev subdomain) for this bucket
R2_SOCIAL_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_SOCIAL_ACCESS_KEY=your-access-key
R2_SOCIAL_SECRET_KEY=your-secret-key
R2_SOCIAL_BUCKET=orion-social
R2_SOCIAL_PUBLIC_URL=https://pub-XXXXX.r2.dev
