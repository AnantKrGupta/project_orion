PORT=3001
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/thapar-chat
ADMIN_EMAILS=admin@thapar.edu

# JWT Secret (change this to a long random string)
JWT_SECRET=your-super-secret-jwt-key-change-this

# Email (Gmail for password reset)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# R2 Chat Account (Cloudflare)
R2_CHAT_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_CHAT_ACCESS_KEY=your-access-key
R2_CHAT_SECRET_KEY=your-secret-key
R2_CHAT_BUCKET=chat-images
R2_CHAT_PUBLIC_URL=https://chat-images.your-domain.com

# R2 Social Account (Cloudflare)
R2_SOCIAL_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_SOCIAL_ACCESS_KEY=your-access-key
R2_SOCIAL_SECRET_KEY=your-secret-key
R2_SOCIAL_BUCKET=social-images
R2_SOCIAL_PUBLIC_URL=https://social-images.your-domain.com
